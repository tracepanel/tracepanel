{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // The Rust and Python sides release on their own cadence: Renovate manages
  // ui/ only. Self-hosted through .github/workflows/renovate.yml.
  extends: ["config:recommended"],
  includePaths: ["ui/**"],
  onboarding: false,
  semanticCommits: "disabled",
  labels: ["dependencies", "ui"],
  prConcurrentLimit: 3,
  prHourlyLimit: 4,
  // Same 48-hour window ui/pnpm-workspace.yaml enforces: no release gets in
  // before the supply-chain bit has aged.
  minimumReleaseAge: "48 hours",
  vulnerabilityAlerts: { enabled: true, labels: ["security", "ui"] },
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on the first day of the month"],
  },
  packageRules: [
    {
      groupName: "ui minor and patch updates",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      schedule: ["before 7am on monday"],
    },
  ],
}
