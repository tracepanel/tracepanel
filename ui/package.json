{
  "name": "tracepanel-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @tracepanel/local dev",
    "fmt": "biome check --write .",
    "lint": "biome check . && pnpm -r typecheck",
    "api": "pnpm --filter @tracepanel/ui api",
    "watch": "TRACEPANEL_UI_OUT=\"$(cd .. && pwd)/ui-dist\" pnpm -r --parallel watch",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "fallow": "3.33.0",
    "lefthook": "2.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
