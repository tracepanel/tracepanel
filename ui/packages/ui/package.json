{
  "name": "@tracepanel/ui",
  "version": "0.0.1",
  "description": "Tracepanel React components: shared by the console and the panel",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./theme.css": "./src/theme.css",
    "./lib/*": "./src/lib/*.ts",
    "./types": "./src/types.ts",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "lefthook": "2.2.2",
    "openapi-typescript": "7.13.0",
    "react": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "typecheck": "tsc6 -p .",
    "api": "node scripts/api.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "graphql": "17.0.2",
    "lucide-react": "1.58.0",
    "radix-ui": "1.8.1",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "3.7.0"
  }
}
