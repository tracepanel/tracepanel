    "./hooks/*": "./src/hooks/*.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "openapi-typescript": "7.13.0",
    "react": "^19.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "api": "node scripts/api.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "graphql": "17.0.2",
    "lucide-react": "1.52.0",
    "prism-react-renderer": "2.4.1",
    "radix-ui": "1.7.0",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "3.7.0"
  }
