{
  "name": "@tracepanel/ui",
  "version": "0.0.1",
  "description": "Tracepanel React components: shared by the console and the panel",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./theme.css": "./src/theme.css",
    "./lib/*": "./src/lib/*.ts",
