{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracepanel.dev/schema/0.1/trace.schema.json",
  "title": "Trace",
  "description": "One unit of work: an HTTP request, a background task or a management command, with its spans, logs, errors and detected issues. Times are Unix epoch microseconds (UTC); durations are microseconds.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "name",
    "start",
    "duration",
    "status",
    "attrs",
    "spans",
    "logs",
    "errors",
    "links",
    "issues"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "enum": [
        "http",
        "task",
        "command",
        "websocket",
        "rpc",
        "page"
      ]
    },
    "name": {
      "type": "string",
      "description": "Human-readable name, e.g. \"GET /posts/<int:pk>/\"."
    },
    "start": {
      "$ref": "#/$defs/time"
    },
    "duration": {
      "$ref": "#/$defs/duration"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "attrs": {
      "$ref": "#/$defs/attrs"
    },
    "spans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/span"
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/log"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "issues": {
      "description": "Found by the agent: SDKs send an empty list, the console's API returns the trace with its issues.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "received": {
      "$ref": "#/$defs/time",
      "description": "When the agent received it, by its machine's clock: set by the agent, never sent. Against start and duration (the app's clock) it tells a clock that is off."
    },
    "calls": {
      "type": "array",
      "description": "Its spans that are calls to another system, as the agent's analysis reads them: set by the agent on a trace it sends on, never by an SDK. The rest of each call is its span's.",
      "items": {
        "$ref": "#/$defs/call"
      }
    },
    "profile": {
      "description": "Where the trace's time went in code, sampled: what was running every interval_us while it ran, as stacks of frames. Recorded when asked for (a setting, or a request's X-Tracepanel-Profile header); left out otherwise.",
      "$ref": "#/$defs/profile"
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_us", "samples", "frames", "stacks"],
      "properties": {
        "interval_us": {
          "type": "integer",
          "minimum": 1,
          "description": "How often a sample was taken, in microseconds: a sample stands for this much time."
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "description": "Samples taken while the trace ran."
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "description": "Samples not taken for this trace because its thread was running other traces too (an event loop with concurrent traces): time the profile can't attribute."
        },
        "bucket_us": {
          "type": "integer",
          "minimum": 1,
          "description": "How wide a time bucket of stacks[].at is, in microseconds, counted from the trace's start."
        },
        "frames": {
          "type": "array",
          "description": "The functions the stacks name, each once.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["function", "file", "line", "in_app"],
            "properties": {
              "function": { "type": "string" },
              "module": { "type": ["string", "null"] },
              "file": {
                "type": "string",
                "description": "As the project sees it: relative to its root for its own code."
              },
              "line": { "type": "integer", "description": "Where the function is defined." },
              "in_app": { "type": "boolean", "description": "The project's own code, not a library's or the runtime's." },
              "waiting": {
                "type": "boolean",
                "description": "Waiting, not computing: asyncio.sleep, an event loop's select, time.sleep, a socket's recv, a lock. A sample whose innermost frame waits counts as waiting."
              },
              "at_line": {
                "type": "integer",
                "description": "The line it was running when sampled (a coroutine's await), where `line` is where it is defined."
              }
            }
          }
        },
        "stacks": {
          "type": "array",
          "description": "Each stack seen, outermost frame first, as indexes into frames, and how many samples saw it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frames", "count"],
            "properties": {
              "frames": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
              "count": { "type": "integer", "minimum": 1 },
              "at": {
                "type": "array",
                "description": "When in the trace the stack was seen: [bucket, count] pairs, a bucket bucket_us wide from the trace's start; the counts add up to count.",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    { "type": "integer", "minimum": 0 },
                    { "type": "integer", "minimum": 1 }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_id", "key", "system", "family", "target", "op", "template", "vendor", "via", "hit"],
      "properties": {
        "span_id": {
          "$ref": "#/$defs/id",
          "description": "The span the call is."
        },
        "key": {
          "type": "string",
          "description": "What groups its repeats: 16 hex, the console's op: and query: key."
        },
        "system": {
          "type": "string",
          "description": "What it is listed under: sql, redis, cache, http, mongodb, kafka, grpc, or a system's own name."
        },
        "family": {
          "type": "string",
          "description": "The rules its issues follow: sql, redis, cache, http, rpc, datastore, messaging."
        },
        "target": {
          "type": "string",
          "description": "Where it went: a database alias, an instance, a host, a topic, an RPC service."
        },
        "op": {
          "type": "string",
          "description": "The verb: SELECT, GET, find, publish, the RPC method."
        },
        "template": {
          "type": "string",
          "description": "What its repeats share: a SQL fingerprint, a key or path with its ids as {id}."
        },
        "vendor": {
          "type": ["string", "null"],
          "description": "SQL: the database vendor; a cache: its backend."
        },
        "via": {
          "type": ["string", "null"],
          "description": "Redis: what sent the command (direct, cache, task)."
        },
        "hit": {
          "type": ["boolean", "null"],
          "description": "A cache get: whether it found the key."
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID."
    },
    "time": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch microseconds, UTC."
    },
    "duration": {
      "type": "integer",
      "minimum": 0,
      "description": "Microseconds."
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "attrs": {
      "type": "object",
      "description": "Namespaced attributes (http.*, db.*, cache.*, code.*, user.*, task.*, signal.*, exception.*). task.* is shared by every task queue (task.system says which: celery, django, django-q, dramatiq, huey, rq, channels). Values are scalars or lists of scalars.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
      },
      "properties": {
        "signal.name": {
          "type": "string",
          "description": "On a signal span and on each of its receivers' spans: the signal's dotted path, e.g. \"django.db.models.signals.post_save\". The signal span's name is Django's own signal by its name (\"post_save\"), any other by this path."
        },
        "signal.sender": {
          "type": "string",
          "description": "On a signal span: who sent it, a model by its label (\"auth.Group\"), any other class by its dotted path. Absent for a send with no sender."
        },
        "signal.receivers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "On a signal span: the dotted path of each receiver it ran, in order. Each receiver is a function span under it."
        },
        "signal.robust": {
          "type": "boolean",
          "description": "On a signal span: true for send_robust() and asend_robust(), which catch what a receiver raises. A failed receiver's span is then an error while the trace stays ok."
        },
        "signal.unreceived": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "On a trace: the sends nobody received, which make no span, once per signal and sender with how many times it was sent, e.g. \"pre_save auth.Group: 3\"."
        },
        "exception.type": {
          "type": "string",
          "description": "On a span that raised (a signal's receiver): the qualified exception class, e.g. \"builtins.ConnectionError\"."
        },
        "exception.message": {
          "type": "string",
          "description": "On a span that raised: the exception's message, cut at 1000 characters."
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        ]
      }
    },
    "span": {
      "type": "object",
      "required": [
        "id",
        "parent_id",
        "kind",
        "name",
        "start",
        "duration",
        "status",
        "attrs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parent_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "description": "otel is an OpenTelemetry span as its instrumentation recorded it, with otel.span_kind and otel.scope among its attributes: the agent maps it to one of the other kinds before it stores the trace, so the console never returns one.",
          "enum": [
            "http",
            "middleware",
            "framework",
            "view",
            "template",
            "sql",
            "transaction",
            "cache",
            "redis",
            "mail",
            "signal",
            "http.client",
            "task.enqueue",
            "task.run",
            "command",
            "function",
            "event",
            "websocket",
            "websocket.send",
            "channel.send",
            "graphql",
            "mongodb",
            "elasticsearch",
            "cassandra",
            "dynamodb",
            "memcached",
            "kafka",
            "rabbitmq",
            "sqs",
            "grpc",
            "db",
            "messaging",
            "rpc",
            "otel",
            "page"
          ]
        },
        "name": {
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "duration": {
          "$ref": "#/$defs/duration"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "attrs": {
          "$ref": "#/$defs/attrs"
        }
      }
    },
    "log": {
      "type": "object",
      "required": [
        "span_id",
        "time",
        "level",
        "logger",
        "message",
        "exception",
        "attrs"
      ],
      "additionalProperties": false,
      "properties": {
        "span_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "level": {
          "enum": [
            "debug",
            "info",
            "warning",
            "error",
            "critical"
          ]
        },
        "logger": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "exception": {
          "type": [
            "string",
            "null"
          ],
          "description": "Formatted traceback when the record carries exc_info."
        },
        "attrs": {
          "$ref": "#/$defs/attrs",
          "description": "Where it was logged (code.*), thread.*, process.*, log.template, and the record's extra fields as extra.*."
        }
      }
    },
    "frame": {
      "type": "object",
      "required": [
        "filename",
        "module",
        "function",
        "lineno",
        "in_app",
        "context_start",
        "context",
        "locals"
      ],
      "additionalProperties": false,
      "properties": {
        "filename": {
          "type": "string",
          "description": "Relative to the project root for application code."
        },
        "module": {
          "type": "string"
        },
        "function": {
          "type": "string"
        },
        "lineno": {
          "type": "integer",
          "minimum": 0
        },
        "in_app": {
          "type": "boolean",
          "description": "True for project code, false for the standard library and installed packages."
        },
        "context_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Line number of the first line in `context`."
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source lines around `lineno`."
        },
        "locals": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "repr() of local variables, project frames only; sensitive names are masked."
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "span_id",
        "time",
        "type",
        "message",
        "handled",
        "frames",
        "chain"
      ],
      "additionalProperties": false,
      "properties": {
        "span_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "type": {
          "type": "string",
          "description": "Qualified exception class, e.g. \"builtins.ZeroDivisionError\"."
        },
        "message": {
          "type": "string"
        },
        "handled": {
          "type": "boolean"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          },
          "description": "Oldest call first."
        },
        "chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chained_error"
          },
          "description": "Inner exceptions, nearest first."
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "kind",
        "trace_id",
        "span_id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "enqueued_by",
            "connection",
            "sent_by"
          ],
          "description": "enqueued_by: this task trace was enqueued from trace_id/span_id. connection: this WebSocket event belongs to the connection opened in trace_id. sent_by: this event handles a channel layer message sent from trace_id/span_id."
        },
        "trace_id": {
          "$ref": "#/$defs/id"
        },
        "span_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "issue": {
      "type": "object",
      "required": [
        "fingerprint",
        "fingerprint_version",
        "kind",
        "title",
        "culprit",
        "hint",
        "count",
        "span_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "Stable group key: the same problem in the same place has the same fingerprint, whichever SDK recorded it."
        },
        "fingerprint_version": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "n+1",
            "duplicates",
            "slow-sql",
            "slow-http",
            "slow-call",
            "error",
            "long-transaction",
            "in-transaction",
            "htmx",
            "queue-wait",
            "blocking-call",
            "large-result"
          ]
        },
        "title": {
          "type": "string"
        },
        "culprit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where in the project code it happens, e.g. \"blog/views.py:21 in post_list\"."
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Occurrences within this trace."
        },
        "span_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "chained_error": {
      "type": "object",
      "required": [
        "relation",
        "type",
        "message",
        "frames"
      ],
      "additionalProperties": false,
      "properties": {
        "relation": {
          "enum": [
            "cause",
            "context"
          ],
          "description": "cause: raise ... from; context: raised while handling."
        },
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      }
    }
  }
}
